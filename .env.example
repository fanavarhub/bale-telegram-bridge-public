# Fill ONLY on your server. Do not commit a completed .env or paste secrets into chat.
BALE_BOT_TOKEN=
TELEGRAM_BOT_TOKEN=
# Required: exactly one allowed human user ID for each platform. No public defaults.
BALE_ALLOWED_USER_ID=
TELEGRAM_ALLOWED_USER_ID=
# Required expected bot usernames, with or without @.
BALE_BOT_USERNAME=
TELEGRAM_BOT_USERNAME=
# Optional: defaults to BALE_ALLOWED_USER_ID. Pin a different private chat only
# after checking --private-chat locally while the bridge is stopped.
BALE_PRIVATE_CHAT_ID=
# Generate ONCE with: npm run key --silent
# Keep the same key with encrypted database backups; never rotate it on restart.
DATA_ENCRYPTION_KEY=
DATA_DIR=./data
POLL_TIMEOUT_SECONDS=25
MAX_FILE_MIB=20
MAX_PENDING_JOBS=1000
METADATA_RETENTION_DAYS=7
SEND_INTERVAL_MS=1100
# Explicit opt-in only when replacing an existing webhook for these same bots.
REMOVE_EXISTING_WEBHOOK=false
