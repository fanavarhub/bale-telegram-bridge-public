{
  "name": "private-bale-telegram-bridge",
  "version": "1.0.0",
  "private": true,
  "description": "A private, durable two-person Bale–Telegram relay",
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "start": "node --env-file=.env src/main.js",
    "test": "node --test",
    "key": "node -e \"process.stdout.write(require('node:crypto').randomBytes(32).toString('base64')+'\\n')\"",
    "doctor": "node --env-file=.env src/doctor.js",
    "queue": "node --env-file=.env src/queue.js"
  }
}
